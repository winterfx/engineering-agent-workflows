# Leave empty to use the agent-compose server-side default model.
ISSUE_TRIAGE_MODEL=

# Start in dry-run. Change to 1 only after reviewing proposed results.
ISSUE_TRIAGE_APPLY=0

# Configure either a legacy static token or GitHub App authentication.
# Client ID is preferred; App ID is a supported fallback. Leave the optional
# Installation ID empty to discover it from the allowed repository.
GITHUB_TOKEN=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_BOT_LOGIN=
GITHUB_ALLOWED_REPOSITORY=chaitin/agent-compose

# The Draft PR workflow starts only from agent:ready or agent:approved labels.
# Keep dry-run enabled until the proposed diff and PR metadata have been reviewed.
DRAFT_PR_MODEL=
DRAFT_PR_APPLY=0
DRAFT_PR_ALLOWED_REPOSITORY=chaitin/agent-compose
