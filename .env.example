# Clone URL for this repository as seen from the guest sandbox.
ENGINEERING_AGENT_WORKFLOWS_REPO=https://github.com/your-org/engineering-agent-workflows.git

# Pin a reviewed tag for production instead of following main.
ENGINEERING_AGENT_WORKFLOWS_REF=v0.1.0

# Use a fine-grained token or GitHub App installation token with Issues read/write.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Leave empty to use the agent-compose server-side default model.
ISSUE_TRIAGE_MODEL=

# Start in dry-run. Change to 1 only after reviewing proposed results.
ISSUE_TRIAGE_APPLY=0
ISSUE_TRIAGE_BOT_LOGIN=engineering-triage[bot]
ISSUE_TRIAGE_GUEST_IMAGE=ghcr.io/chaitin/agent-compose-guest:latest

