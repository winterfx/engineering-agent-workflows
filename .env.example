# Use a GitLab personal, project, or group access token with API scope.
# This is an API credential and is separate from the webhook Secret token.
GITLAB_TOKEN=
GITLAB_API_URL=https://gitlab.com/api/v4

# Leave empty to use the agent-compose server-side default model.
ISSUE_TRIAGE_MODEL=

# Start in dry-run. Change to 1 only after reviewing proposed results.
ISSUE_TRIAGE_APPLY=0
GITLAB_BOT_USERNAME=engineering-triage-bot

# GitHub is optional. Configure these to enable GitHub Issue webhooks.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_SERVER_URL=https://github.com
GITHUB_BOT_LOGIN=
GITHUB_ALLOWED_REPOSITORY=chaitin/agent-compose
# Used only by the trusted host-side GitHub webhook relay.
GITHUB_WEBHOOK_SECRET=
AGENT_COMPOSE_WEBHOOK_TOKEN=
AGENT_COMPOSE_WEBHOOK_BASE_URL=http://172.18.0.1:7410/api/webhooks
GITHUB_WEBHOOK_LISTEN_HOST=127.0.0.1
GITHUB_WEBHOOK_LISTEN_PORT=7411

# The Draft PR workflow starts only from agent:ready or agent:approved labels.
# Keep dry-run enabled until the proposed diff and PR metadata have been reviewed.
DRAFT_PR_MODEL=
DRAFT_PR_APPLY=0
DRAFT_PR_ALLOWED_REPOSITORY=chaitin/agent-compose
DRAFT_PR_GIT_AUTHOR_NAME=engineering-agent-workflows
DRAFT_PR_GIT_AUTHOR_EMAIL=engineering-agent-workflows@users.noreply.github.com
# Must identify a different account from GITHUB_BOT_LOGIN.
MONKEYSCAN_BOT_LOGIN=
# Optional numeric GitHub user ID; when set, both login and ID must match.
MONKEYSCAN_BOT_USER_ID=
