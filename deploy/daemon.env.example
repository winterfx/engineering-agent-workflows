# These variables configure the agent-compose daemon, not the project sandbox.
WEBHOOK_QUEUE_DEFAULT_WORKERS=4
WEBHOOK_QUEUE_RULES_JSON=[{"name":"gitlab-issue-triage","workers":1,"match":{"topic":"webhook.gitlab.issue"}},{"name":"gitlab-note-triage","workers":1,"match":{"topic":"webhook.gitlab.note"}},{"name":"github-issue-workflows","workers":4,"match":{"topic":"webhook.github.issues"}},{"name":"github-comment-workflows","workers":4,"match":{"topic":"webhook.github.issue_comment"}},{"name":"github-review-workflows","workers":4,"match":{"topic":"webhook.github.pull_request_review"}},{"name":"github-review-comment-workflows","workers":4,"match":{"topic":"webhook.github.pull_request_review_comment"}},{"name":"github-check-suite-workflows","workers":4,"match":{"topic":"webhook.github.check_suite"}}]
